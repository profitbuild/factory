{
  "title": "What a run's credential proxy counted, $FACTORY_STATE_DIR/tasks/<runId>/proxy.json",
  "description": "The proxy's own (incident-platform backlog #0-313 AC3, AC8; dispatcher/src/proxy/usage.mjs), apart from task.json, which the phases write: the requests forwarded and refused (by the proxy's reason), the tokens summed from each response's stream (unmetered: the responses it could not count), the last response's rate-limit headers (a name of their form, a number or an ISO time; those off it counted in rateLimitsDropped), and the names of the request headers it dropped (no value; at most 32, the rest counted in droppedHeadersUncounted). No value of a request's, and no key or token.",
  "type": "object",
  "required": ["version", "runId", "forwarded", "refused", "usage", "rateLimits", "rateLimitsDropped", "droppedHeaders",
    "droppedHeadersUncounted"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "runId": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{6}$" },
    "forwarded": { "type": "integer", "minimum": 0 },
    "refused": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "no-token": { "type": "integer", "minimum": 0 },
        "credentials-differ": { "type": "integer", "minimum": 0 },
        "unknown-token": { "type": "integer", "minimum": 0 },
        "token-not-active": { "type": "integer", "minimum": 0 },
        "path": { "type": "integer", "minimum": 0 },
        "in-flight": { "type": "integer", "minimum": 0 },
        "body-too-large": { "type": "integer", "minimum": 0 },
        "upstream": { "type": "integer", "minimum": 0 },
        "body-not-json": { "type": "integer", "minimum": 0 },
        "body-not-object": { "type": "integer", "minimum": 0 },
        "mcp-servers": { "type": "integer", "minimum": 0 },
        "tools-not-list": { "type": "integer", "minimum": 0 },
        "server-tool": { "type": "integer", "minimum": 0 },
        "beta": { "type": "integer", "minimum": 0 }
      }
    },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "cache_creation_input_tokens", "cache_read_input_tokens",
        "unmetered"],
      "additionalProperties": false,
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cache_creation_input_tokens": { "type": "integer", "minimum": 0 },
        "cache_read_input_tokens": { "type": "integer", "minimum": 0 },
        "unmetered": { "type": "integer", "minimum": 0 }
      }
    },
    "rateLimits": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^(?:[0-9]{1,20}|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z)$" }
    },
    "rateLimitsDropped": { "type": "integer", "minimum": 0 },
    "droppedHeaders": { "type": "array", "maxItems": 32, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" } },
    "droppedHeadersUncounted": { "type": "integer", "minimum": 0 }
  }
}
