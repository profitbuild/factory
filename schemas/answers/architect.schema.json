{
  "$id": "https://github.com/profitbuild/factory/blob/main/schemas/answers/architect.schema.json",
  "title": "The architect's answer",
  "description": "The structured output of a factory:architect call (incident-platform backlog #0-301, the owner's g1): the same file goes to claude's --json-schema and to dispatcher/src/schema/validate.mjs. Its example is agents/architect.md's \"## Answer (JSON)\".",
  "type": "object",
  "required": [
    "blocked",
    "reason",
    "plan",
    "adrs",
    "risks",
    "areas",
    "modules",
    "rules",
    "commitMessage"
  ],
  "additionalProperties": false,
  "properties": {
    "blocked": {
      "description": "true when the agent stops the item; the owner decides.",
      "type": "boolean"
    },
    "reason": {
      "description": "why it stopped, or null: the agent's words, kept in its answer file, never in a decision of the dispatcher's.",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    },
    "plan": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "summary",
        "precedent",
        "steps",
        "files",
        "tests",
        "acceptanceMapping"
      ],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 4000
        },
        "precedent": {
          "type": "string",
          "maxLength": 2000
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          },
          "maxItems": 100
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          },
          "maxItems": 500
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "maxItems": 200
        },
        "acceptanceMapping": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ac",
              "test"
            ],
            "additionalProperties": false,
            "properties": {
              "ac": {
                "type": "string",
                "maxLength": 50
              },
              "test": {
                "type": "string",
                "maxLength": 1000
              }
            }
          },
          "maxItems": 100
        }
      }
    },
    "adrs": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300
      },
      "maxItems": 20
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      },
      "maxItems": 50
    },
    "areas": {
      "type": "object",
      "required": [
        "security",
        "migration",
        "k8sOrBuild",
        "docs"
      ],
      "additionalProperties": false,
      "properties": {
        "security": {
          "type": "boolean"
        },
        "migration": {
          "type": "boolean"
        },
        "k8sOrBuild": {
          "type": "boolean"
        },
        "docs": {
          "type": "boolean"
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      },
      "maxItems": 50
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "why"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100
          },
          "why": {
            "type": "string",
            "maxLength": 1000
          }
        }
      },
      "maxItems": 200
    },
    "commitMessage": {
      "description": "The message of the commit the factory makes of this call's changes (#0-302), or null when no file changed: the agent's words. Its form (decision 3 of #0-302, PR #695 of incident-platform): a subject of one line, 1 to 100 characters; then, if there is a body, a blank line and the body, which holds more than blank lines; printable characters and \\n alone (no tab, no carriage return, no other control character), at most 8000 in all; and no line that reads as one of the dispatcher's trailers (Factory-…:, Task:, Feature:), which the dispatcher writes itself.",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8000,
      "pattern": "^(?![\\s\\S]*(?:^|\\n)(?:Factory-[A-Za-z0-9-]*|Task|Feature):)[^\\u0000-\\u001f\\u007f]{1,100}(?:\\n\\n(?=[\\s\\S]*\\S)[^\\u0000-\\u0009\\u000b-\\u001f\\u007f]*)?$"
    }
  }
}
